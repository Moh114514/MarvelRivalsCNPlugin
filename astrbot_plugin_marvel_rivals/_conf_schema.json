{
  "MRCN_API_BASE_URL": {
    "description": "Official CN mini-program API base URL",
    "type": "string",
    "default": "https://s3.game.163.com/35a06fa941672d97"
  },
  "MRCN_REQUEST_BODY_TEMPLATE": {
    "description": "Default POST JSON template. Use {uid} placeholder.",
    "type": "string",
    "default": "{\"roleId\":\"{uid}\"}"
  },
  "MRCN_HEADERS_JSON": {
    "description": "Request headers JSON. Keep temporary credentials local.",
    "type": "string",
    "default": "{\"User-Agent\":\"Mozilla/5.0\"}"
  },
  "MRCN_ACCESS_TOKEN": {
    "description": "Temporary access_token from the mini-program request header",
    "hint": "敏感凭据：仅在受控的 AstrBot WebUI 中填写，不要截图、分享或提交 data/config 下的配置文件。Token 过期后需要更新。",
    "obvious_hint": true,
    "type": "string",
    "default": ""
  },
  "MRCN_CA_CERT": {
    "description": "Optional CA PEM path, for example the mitmproxy CA certificate",
    "type": "string",
    "default": ""
  },
  "MRCN_VERIFY_SSL": {
    "description": "Keep TLS verification enabled; disable only for local diagnosis",
    "type": "boolean",
    "default": true
  },
  "MRCN_PROXY": {
    "description": "Optional HTTP proxy, for example http://127.0.0.1:8080",
    "type": "string",
    "default": ""
  },
  "MRCN_TRUST_ENV": {
    "description": "Whether httpx should inherit HTTP_PROXY/HTTPS_PROXY from the process environment",
    "type": "boolean",
    "default": false
  },
  "MRCN_TIMEOUT_SECONDS": {
    "description": "HTTP request timeout",
    "type": "float",
    "default": 10
  },
  "MRCN_CACHE_SECONDS": {
    "description": "Cache duration for formatted query results",
    "type": "int",
    "default": 60
  },
  "MRCN_ROLE_PATH": {
    "description": "Resolve and validate a public role ID",
    "type": "string",
    "default": "/api/role/loadByRoleId"
  },
  "MRCN_DATA_PATH": {
    "description": "loadData endpoint path",
    "type": "string",
    "default": "/api/game/player/loadData"
  },
  "MRCN_SUMMARY_PATH": {
    "description": "loadSummary endpoint path",
    "type": "string",
    "default": "/api/game/player/loadSummary"
  },
  "MRCN_SUMMARY_DETAIL_PATH": {
    "description": "loadSummaryDetail endpoint path",
    "type": "string",
    "default": "/api/game/player/loadSummaryDetail"
  },
  "MRCN_CAREER_PATH": {
    "description": "loadCareer endpoint path",
    "type": "string",
    "default": "/api/game/player/loadCareer"
  },
  "MRCN_HERO_PATH": {
    "description": "loadHeroCareer endpoint path",
    "type": "string",
    "default": "/api/game/player/loadHeroCareer"
  },
  "MRCN_SORT_HERO_PATH": {
    "description": "loadSortHero endpoint path",
    "type": "string",
    "default": "/api/game/player/loadSortHero"
  },
  "MRCN_MATCHES_PATH": {
    "description": "Confirmed recent matches endpoint path",
    "type": "string",
    "default": "/api/game/player/loadSummary"
  },
  "MRCN_HERO_BODY_TEMPLATE": {
    "description": "Hero request JSON template. Use {hero_ids} and {player_uid} placeholders.",
    "type": "string",
    "default": "{\"heroIdList\":{hero_ids},\"matchSeason\":\"19\",\"playerUid\":{player_uid}}"
  },
  "MRCN_DATA_BODY_TEMPLATE": {
    "description": "loadData request JSON template. Use {player_uid}.",
    "type": "string",
    "default": "{\"playerUid\":{player_uid}}"
  },
  "MRCN_SUMMARY_BODY_TEMPLATE": {
    "description": "Summary and recent-match request JSON template",
    "type": "string",
    "default": "{\"matchSeason\":{\"$eq\":\"19\"},\"gameModeId\":{\"$in\":[1,2,4]},\"playModeId\":{\"$in\":[0,7,8]},\"page\":0,\"pageSize\":10,\"playerUid\":{player_uid}}"
  },
  "MRCN_CAREER_BODY_TEMPLATE": {
    "description": "Career request JSON template",
    "type": "string",
    "default": "{\"matchSeason\":\"19\",\"playerUid\":{player_uid}}"
  },
  "MRCN_SORT_HERO_BODY_TEMPLATE": {
    "description": "Sorted heroes request JSON template",
    "type": "string",
    "default": "{\"matchSeason\":\"19\",\"playerUid\":{player_uid}}"
  },
  "MRCN_SUMMARY_DETAIL_BODY_TEMPLATE": {
    "description": "Match detail request JSON template. Use {match_uid}.",
    "type": "string",
    "default": "{\"matchUids\":[\"{match_uid}\"]}"
  },
  "MRCN_MATCHES_BODY_TEMPLATE": {
    "description": "Recent matches request JSON template",
    "type": "string",
    "default": "{\"matchSeason\":{\"$eq\":\"19\"},\"gameModeId\":{\"$in\":[1,2,4]},\"playModeId\":{\"$in\":[0,7,8]},\"page\":0,\"pageSize\":10,\"playerUid\":{player_uid}}"
  }
}
