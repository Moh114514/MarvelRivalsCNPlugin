MRCN_API_BASE_URL=https://s3.game.163.com/35a06fa941672d97
MRCN_HEADERS_JSON={"User-Agent":"Mozilla/5.0","xweb_xhr":"1","Content-Type":"application/json"}
MRCN_ACCESS_TOKEN=
MRCN_CA_CERT=
MRCN_VERIFY_SSL=true
MRCN_PROXY=
MRCN_TRUST_ENV=false
MRCN_TIMEOUT_SECONDS=10
MRCN_CACHE_SECONDS=60
MRCN_META_ENABLED=true
MRCN_RIVALSMETA_BASE_URL=https://rivalsmeta.com
MRCN_RIVALSMETA_HERO_STATS_PATH=/api/heroes/stats
MRCN_META_TIMEOUT_SECONDS=10
MRCN_META_CACHE_SECONDS=600
MRCN_META_STALE_SECONDS=86400
MRCN_ASSET_CACHE_DIR=
MRCN_ASSET_REFRESH_DAYS=30
MRCN_ASSET_MAX_CONCURRENCY=4
MRCN_ASSET_TIMEOUT_SECONDS=10
MRCN_DEFAULT_SEASON=19

MRCN_ROLE_PATH=/api/role/loadByRoleId
MRCN_DATA_PATH=/api/game/player/loadData
MRCN_SUMMARY_PATH=/api/game/player/loadSummary
MRCN_SUMMARY_DETAIL_PATH=/api/game/player/loadSummaryDetail
MRCN_CAREER_PATH=/api/game/player/loadCareer
MRCN_HERO_PATH=/api/game/player/loadHeroCareer
MRCN_SORT_HERO_PATH=/api/game/player/loadSortHero
MRCN_MATCHES_PATH=/api/game/player/loadSummary

MRCN_DATA_BODY_TEMPLATE={"playerUid":{player_uid}}
MRCN_SUMMARY_BODY_TEMPLATE={"matchSeason":{"$eq":"{season}"},"gameModeId":{"$in":[1,2,4]},"playModeId":{"$in":[0,7,8]},"page":0,"pageSize":3,"playerUid":{player_uid}}
MRCN_SUMMARY_DETAIL_BODY_TEMPLATE={"matchUids":{match_uids}}
MRCN_CAREER_BODY_TEMPLATE={"matchSeason":"{season}","playerUid":{player_uid}}
MRCN_HERO_BODY_TEMPLATE={"heroIdList":{hero_ids},"matchSeason":"{season}","playerUid":{player_uid}}
MRCN_SORT_HERO_BODY_TEMPLATE={"matchSeason":"{season}","playerUid":{player_uid}}
MRCN_MATCHES_BODY_TEMPLATE={"matchSeason":{"$eq":"{season}"},"gameModeId":{"$in":[1,2,4]},"playModeId":{"$in":[0,7,8]},"page":0,"pageSize":10,"playerUid":{player_uid}}
